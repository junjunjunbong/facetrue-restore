# No GPU or external services are used in mock mode.
FACETRUE_MODE=mock
FACETRUE_HOST=127.0.0.1
FACETRUE_PORT=8000
FACETRUE_DATA_DIR=./data

# Run the proxy on this Mac and point it at the GPU PC via its reachable LAN/VPN address.
COMFYUI_URL=http://127.0.0.1:8188
COMFY_PROXY_URL=http://127.0.0.1:8189

# Model dimensions must be multiples of 32. 1280x736 is padded HD-sized output.
FACETRUE_WIDTH=1280
FACETRUE_HEIGHT=736
FACETRUE_FPS=24
FACETRUE_MAX_SECONDS=10
FACETRUE_SEED=42
FACETRUE_STEPS=8
FACETRUE_JOB_TIMEOUT_SECONDS=7200
FACETRUE_UPLOAD_LIMIT_MB=256
